#!/usr/bin/env python3
"""Regenerate every membox icon asset from brand/icon-master.png.

The master is raw generated art on a painted fake-transparency checkerboard.
We find the dark artwork, crop it square, and cut our own Apple squircle so the
geometry is exact instead of whatever the model drew.

Usage: bin/icons [path/to/master.png]
"""
import os, subprocess, sys
from PIL import Image

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MASTER = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, "brand", "icon-master.png")
OUT = os.path.join(ROOT, "brand", "generated")

SQUIRCLE_N = 5.0   # Apple's superellipse exponent
SS = 4             # supersample factor for the mask
MAC_INSET = 824 / 1024  # Apple macOS icon grid: art fills 824 of 1024


def artwork_bbox(im, threshold=110):
    """Bounding box of the dark icon body, ignoring the light checkerboard."""
    g = im.convert("L")
    mask = g.point(lambda p: 255 if p < threshold else 0)
    bbox = mask.getbbox()
    if bbox is None:
        raise SystemExit("no dark artwork found in master — is it the right image?")
    return bbox


def square_crop(im, bbox):
    l, t, r, b = bbox
    cx, cy = (l + r) / 2, (t + b) / 2
    side = max(r - l, b - t)
    half = side / 2
    box = (round(cx - half), round(cy - half), round(cx + half), round(cy + half))
    return im.crop(box)


def squircle_mask(size):
    """Antialiased superellipse mask via row-wise extents at SS× then downscale."""
    n = size * SS
    m = Image.new("L", (n, n), 0)
    px = m.load()
    half = n / 2
    for y in range(n):
        v = abs((y + 0.5 - half) / half)
        if v >= 1.0:
            continue
        # |x|^N + |y|^N = 1  ->  x = (1 - |y|^N)^(1/N)
        u = (1.0 - v ** SQUIRCLE_N) ** (1.0 / SQUIRCLE_N)
        x0, x1 = int(half - u * half), int(half + u * half)
        for x in range(x0, x1):
            px[x, y] = 255
    return m.resize((size, size), Image.LANCZOS)


def write(img, *parts):
    path = os.path.join(OUT, *parts)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    img.save(path)
    return path


def main():
    src = Image.open(MASTER).convert("RGB")
    art = square_crop(src, artwork_bbox(src))
    art1024 = art.resize((1024, 1024), Image.LANCZOS)

    # --- iOS: full-bleed square, no alpha, no corners (iOS masks it itself) ---
    write(art1024, "ios", "AppIcon.appiconset", "icon-1024.png")
    write(Image.eval(art1024, lambda p: int(p * 0.82)), "ios", "AppIcon.appiconset", "icon-1024-dark.png")
    with open(os.path.join(OUT, "ios", "AppIcon.appiconset", "Contents.json"), "w") as f:
        f.write("""{
  "images" : [
    { "filename" : "icon-1024.png", "idiom" : "universal", "platform" : "ios", "scale" : "1x", "size" : "1024x1024" },
    { "appearances" : [ { "appearance" : "luminosity", "value" : "dark" } ], "filename" : "icon-1024-dark.png", "idiom" : "universal", "platform" : "ios", "scale" : "1x", "size" : "1024x1024" }
  ],
  "info" : { "author" : "membox", "version" : 1 }
}
""")

    # --- shared masked mark (real alpha) ---
    mark = art1024.convert("RGBA")
    mark.putalpha(squircle_mask(1024))
    write(mark, "mark-1024.png")
    write(mark.resize((512, 512), Image.LANCZOS), "launch-mark-512.png")

    # --- macOS: masked art inset on the 1024 grid, then .icns ---
    inset = round(1024 * MAC_INSET)
    canvas = Image.new("RGBA", (1024, 1024), (0, 0, 0, 0))
    off = (1024 - inset) // 2
    canvas.paste(mark.resize((inset, inset), Image.LANCZOS), (off, off))

    iconset = os.path.join(OUT, "mac", "AppIcon.iconset")
    os.makedirs(iconset, exist_ok=True)
    for pt in (16, 32, 128, 256, 512):
        for scale in (1, 2):
            px = pt * scale
            name = f"icon_{pt}x{pt}{'@2x' if scale == 2 else ''}.png"
            canvas.resize((px, px), Image.LANCZOS).save(os.path.join(iconset, name))
    subprocess.run(["iconutil", "-c", "icns", iconset, "-o",
                    os.path.join(OUT, "mac", "AppIcon.icns")], check=True)


    # --- iOS launch screen assets (UILaunchScreen plist dict, no storyboard) ---
    ls = os.path.join(OUT, "ios")
    os.makedirs(os.path.join(ls, "LaunchBackground.colorset"), exist_ok=True)
    with open(os.path.join(ls, "LaunchBackground.colorset", "Contents.json"), "w") as f:
        f.write("""{
  "colors" : [
    { "color" : { "color-space" : "srgb", "components" : { "alpha" : "1.000", "blue" : "0x19", "green" : "0x14", "red" : "0x0F" } }, "idiom" : "universal" }
  ],
  "info" : { "author" : "membox", "version" : 1 }
}
""")
    imgset = os.path.join(ls, "LaunchMark.imageset")
    os.makedirs(imgset, exist_ok=True)
    for scale in (1, 2, 3):
        mark.resize((160 * scale, 160 * scale), Image.LANCZOS).save(
            os.path.join(imgset, f"LaunchMark@{scale}x.png"))
    with open(os.path.join(imgset, "Contents.json"), "w") as f:
        f.write("""{
  "images" : [
    { "filename" : "LaunchMark@1x.png", "idiom" : "universal", "scale" : "1x" },
    { "filename" : "LaunchMark@2x.png", "idiom" : "universal", "scale" : "2x" },
    { "filename" : "LaunchMark@3x.png", "idiom" : "universal", "scale" : "3x" }
  ],
  "info" : { "author" : "membox", "version" : 1 }
}
""")
    with open(os.path.join(ls, "LaunchScreen-Info.plist.snippet"), "w") as f:
        f.write("""<!-- Paste into ios Info.plist. No storyboard needed (iOS 14+). -->
<key>UILaunchScreen</key>
<dict>
  <key>UIColorName</key><string>LaunchBackground</string>
  <key>UIImageName</key><string>LaunchMark</string>
  <key>UIImageRespectsSafeAreaInsets</key><false/>
</dict>
""")


    # --- Tauri window/bundle icons (must be RGBA, or generate_context! panics) ---
    tauri = os.path.join(OUT, "tauri")
    os.makedirs(tauri, exist_ok=True)
    for name, px in (("32x32.png", 32), ("128x128.png", 128),
                     ("128x128@2x.png", 256), ("icon.png", 1024)):
        canvas.resize((px, px), Image.LANCZOS).convert("RGBA").save(
            os.path.join(tauri, name))
    subprocess.run(["cp", os.path.join(OUT, "mac", "AppIcon.icns"),
                    os.path.join(tauri, "icon.icns")], check=True)

    # --- Tauri dev icons: same mark, golden DEV badge, so the two Dock icons differ ---
    from PIL import ImageDraw
    badged = canvas.copy()
    d = ImageDraw.Draw(badged)
    d.rounded_rectangle([600, 680, 924, 820], radius=36, fill=(245, 185, 66, 255))
    try:
        from PIL import ImageFont
        font = ImageFont.truetype("/System/Library/Fonts/SFCompact.ttf", 96)
    except Exception:
        font = None
    d.text((762, 750), "DEV", fill=(20, 26, 38, 255), anchor="mm", font=font)
    dev = os.path.join(OUT, "tauri-dev")
    os.makedirs(dev, exist_ok=True)
    for name, px in (("32x32.png", 32), ("128x128.png", 128), ("128x128@2x.png", 256), ("icon.png", 1024)):
        badged.resize((px, px), Image.LANCZOS).convert("RGBA").save(os.path.join(dev, name))
    devset = os.path.join(OUT, "tauri-dev", "AppIcon.iconset")
    os.makedirs(devset, exist_ok=True)
    for pt in (16, 32, 128, 256, 512):
        for scale in (1, 2):
            px = pt * scale
            badged.resize((px, px), Image.LANCZOS).save(os.path.join(devset, f"icon_{pt}x{pt}{'@2x' if scale == 2 else ''}.png"))
    subprocess.run(["iconutil", "-c", "icns", devset, "-o", os.path.join(dev, "icon.icns")], check=True)

    # --- contact sheet: does it survive 16px? ---
    sheet = Image.new("RGBA", (1024, 300), (15, 20, 25, 255))
    x = 24
    for px in (256, 128, 64, 32, 16):
        sheet.alpha_composite(canvas.resize((px, px), Image.LANCZOS), (x, 24))
        x += px + 24
    write(sheet, "contact-sheet.png")

    print(f"wrote {OUT}")


if __name__ == "__main__":
    main()
