#!/usr/bin/env bash
# Put the release secrets .github/workflows/release.yml needs onto the GitHub
# repo. Run once (and again after rotating a key). Needs `gh auth login`.
#
# The updater key is membox's own (~/Desktop/membox-updater-key — back it up: losing
# it strands every installed copy). The Developer ID .p12 and the App Store
# Connect key are the same Apple ones inbox2 and gliph sign with.
set -euo pipefail
REPO=Kunba-Labs/membox
KEY=${MEMBOX_UPDATER_KEY_DIR:-$HOME/Desktop/membox-updater-key}
P12_DIR=${APPLE_P12_DIR:-$HOME/Desktop/inbox2-updater-key}
ASC=${APPLE_API_KEY:-H9PLG58DB9}
set_() { gh secret set "$1" -R "$REPO" --body "$2" >/dev/null && echo "set $1"; }

set_ TAURI_SIGNING_PRIVATE_KEY "$(cat "$KEY/membox.key")"
set_ TAURI_SIGNING_PRIVATE_KEY_PASSWORD "$(cat "$KEY/password.txt")"
# The .p12 holds every identity (Development, Distribution, Developer ID) and
# Tauri signs with the first — Apple Development — then refuses because it is
# not APPLE_SIGNING_IDENTITY. Re-pack just the Developer ID cert and its key.
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
openssl pkcs12 -legacy -in "$P12_DIR/apple-signing-identities.p12" -passin file:"$P12_DIR/apple-signing-p12-password.txt" -nodes -out "$TMP/all.pem"
python3 - "$TMP" <<'PY'
import re, sys
d = sys.argv[1]; pem = open(f"{d}/all.pem").read()
blocks = re.findall(r"Bag Attributes.*?-----END [A-Z ]+-----", pem, re.S)
kid = lambda b: re.search(r"localKeyID: ([0-9A-F ]+)", b).group(1)
cert = next(b for b in blocks if "BEGIN CERTIFICATE" in b and "CN=Developer ID Application" in b.replace(" = ", "="))
key = next(b for b in blocks if "PRIVATE KEY" in b and kid(b) == kid(cert))
strip = lambda b: b[b.index("-----BEGIN"):] + "\n"
open(f"{d}/cert.pem", "w").write(strip(cert)); open(f"{d}/key.pem", "w").write(strip(key))
PY
openssl pkcs12 -export -legacy -in "$TMP/cert.pem" -inkey "$TMP/key.pem" -passout file:"$P12_DIR/apple-signing-p12-password.txt" -out "$TMP/devid.p12"
set_ APPLE_CERTIFICATE "$(base64 -i "$TMP/devid.p12")"
set_ APPLE_CERTIFICATE_PASSWORD "$(cat "$P12_DIR/apple-signing-p12-password.txt")"
set_ APPLE_SIGNING_IDENTITY "Developer ID Application: Waseem Sadiq (KF53B4S5HD)"
set_ APPLE_API_KEY "$ASC"
set_ APPLE_API_ISSUER "${APPLE_API_ISSUER:-d5f5385b-5e34-4d70-925d-0debd3a3e090}"
set_ APPLE_API_KEY_P8 "$(cat "$HOME/.appstoreconnect/private_keys/AuthKey_$ASC.p8")"
